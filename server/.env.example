# Copia este archivo a .env para desarrollo local y reemplaza los valores de ejemplo.
# No guardes credenciales reales en Git.

POSTGRES_DB=jaibaspace
POSTGRES_USER=jaibaspace
POSTGRES_PASSWORD=cambiar_solo_para_desarrollo

# En Docker Compose el host es el nombre del servicio: db.
# Fuera de Docker, cambia db por localhost.
DATABASE_URL=postgresql+psycopg://jaibaspace:cambiar_solo_para_desarrollo@db:5432/jaibaspace

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MIN_STATS_SAMPLE_SIZE=10

# Orígenes permitidos para solicitudes del navegador, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Expresión regular de orígenes adicionales. Vacía: con APP_ENV=development se aceptan
# localhost y las IP privadas (10.x, 172.16–31.x, 192.168.x) en cualquier puerto, para abrir
# la PWA desde el celular por la red local. En otro entorno, vacía = ningún origen extra.
CORS_ORIGIN_REGEX=

# Carpeta con data/ y fixtures/ que lee `python -m app.seed`.
# Vacía = la carpeta app/ del repositorio (uso sin Docker). Docker Compose la fija por su cuenta.
PUBLISHED_DIR=

# Opcional: carpeta con el build de la PWA (app/dist) para servirla desde la misma API.
PWA_DIST_DIR=
