{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaibaspace.local/schemas/siembra",
  "title": "Siembra (SIEMBRA)",
  "type": "object",
  "required": [
    "id",
    "temporadaId",
    "parcelaId",
    "cultivoId",
    "fecha"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "temporadaId": {
      "type": "string"
    },
    "parcelaId": {
      "type": "string"
    },
    "cultivoId": {
      "type": "string"
    },
    "semillaId": {
      "type": [
        "string",
        "null"
      ]
    },
    "variedadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "superficieM2": {
      "type": [
        "number",
        "null"
      ]
    },
    "fecha": {
      "type": "object",
      "required": [
        "anio",
        "precision"
      ],
      "properties": {
        "anio": {
          "type": "integer",
          "minimum": 1900
        },
        "mes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "dia": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 31
        },
        "precision": {
          "enum": [
            "anio",
            "mes",
            "dia"
          ]
        }
      },
      "additionalProperties": false
    },
    "observaciones": {
      "type": [
        "string",
        "null"
      ]
    },
    "eliminadaEn": {
      "type": [
        "string",
        "null"
      ]
    },
    "motivo": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "motivoId": {
          "type": "string"
        },
        "motivoTexto": {
          "type": "string"
        },
        "nota": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
