# Copia como .env para ajustes locales. No hay credenciales necesarias para NASA POWER.
PIPELINE_SITES_FILE=config/sites.json
PIPELINE_START_DATE=2001-01-01
PIPELINE_END_DATE=2025-12-31
PIPELINE_RAW_DIR=raw
PIPELINE_STAGING_DIR=staging
PIPELINE_EXPORTS_DIR=exports
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=180
NASA_POWER_RETRIES=3
